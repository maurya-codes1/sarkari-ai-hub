  "curriculum_structure": {
    "subjects": [
      {
        "subject_id": "ibps-banking-quantitative-aptitude",
        "name": "Banking Quantitative Aptitude & Data Interpretation",
        "total_questions": 300,
        "marks_per_question": 1.0,
        "negative_marks": 0.25,
        "domains": [
          "Number Series (Missing & Wrong Number)",
          "Simplification & Approximation",
          "Quadratic Equations Comparison",
          "Data Interpretation (Tables, Bar Graphs, Pie Charts, Radar, Line)",
          "Caselet DI & Arithmetic-Based DI",
          "Data Sufficiency",
          "Percentages, Profit & Loss, Discount",
          "Simple & Compound Interest (Installments)",
          "Time & Work, Pipes & Cisterns",
          "Time, Speed, Distance, Boats & Streams",
          "Ratio & Proportion, Partnership, Mixtures & Alligations",
          "Permutations, Combinations & Probability"
        ]
      },
      {
        "subject_id": "ibps-banking-reasoning-ability",
        "name": "Banking Reasoning Ability & Puzzles",
        "total_questions": 300,
        "marks_per_question": 1.0,
        "negative_marks": 0.25,
        "domains": [
          "Seating Arrangements (Linear, Circular, Square, Triangular)",
          "Floor Puzzles, Box Puzzles, Day/Month/Year Scheduling",
          "Syllogisms (Only a few, Some not, Possibility cases)",
          "Inequalities (Direct & Coded)",
          "Coding-Decoding (Chinese, Matrix & New Pattern)",
          "Blood Relations & Direction Sense",
          "Machine Input-Output",
          "Order & Ranking",
          "Critical Reasoning (Statements & Assumptions, Course of Action, Cause & Effect)"
        ]
      },
      {
        "subject_id": "ibps-banking-english-language",
        "name": "Banking English Language & Verbal Ability",
        "total_questions": 300,
        "marks_per_question": 1.0,
        "negative_marks": 0.25,
        "domains": [
          "Reading Comprehension (Financial, Economic, Editorial themes)",
          "Cloze Test",
          "Spotting Errors & Phrase Replacement",
          "Para Jumbles & Sentence Rearrangement",
          "Double Fillers & Single Fillers",
          "Word Swap & Word Rearrangement",
          "Sentence Connectors & Starters",
          "Idiomatic Expressions & High-Frequency Banking Vocabulary"
        ]
      },
      {
        "subject_id": "ibps-banking-general-financial-awareness",
        "name": "Banking, Financial Awareness & Current Economy",
        "total_questions": 300,
        "marks_per_question": 1.0,
        "negative_marks": 0.25,
        "domains": [
          "Reserve Bank of India (RBI) Structure, Functions & Subsidiary Bodies",
          "RBI Monetary Policy Tools (Repo, Reverse Repo, SDF, MSF, CRR, SLR)",
          "Indian Banking Architecture (PSBs, Private Banks, Small Finance Banks, Payments Banks)",
          "Priority Sector Lending (PSL) & Financial Inclusion Schemes",
          "National Payments Corporation of India (NPCI) Platforms (UPI, RuPay, IMPS, NACH, AePS)",
          "Non-Performing Assets (NPAs), SARFAESI Act, IBC Code & PCA Framework",
          "Negotiable Instruments Act, 1881 (Cheques, Promissory Notes, Bills of Exchange)",
          "Basel III Capital Accord Norms",
          "Union Budget, Economic Survey & Financial News (Last 6 Months)",
          "Important Financial Institutions (NABARD, SIDBI, EXIM, SEBI, IRDAI, PFRDA)"
        ]
      }
    ]
  }
}
