      "stage_name": "Main Examination (IBPS/SBI PO & Clerk)",
      "duration_minutes": 180,
      "total_questions": 155,
      "total_marks": 200,
      "negative_marking": 0.25,
      "sections": [
        { "name": "Reasoning & Computer Aptitude", "questions": 45, "marks": 60, "time_mins": 60 },
        { "name": "General / Economy / Banking Awareness", "questions": 40, "marks": 40, "time_mins": 35 },
        { "name": "English Language", "questions": 35, "marks": 40, "time_mins": 40 },
        { "name": "Data Analysis & Interpretation", "questions": 35, "marks": 60, "time_mins": 45 }
      ]
